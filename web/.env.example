# Public URL of the site, used for the Steam sign-in return address and links in API responses.
APP_URL=http://localhost:3000

# https://steamcommunity.com/dev/apikey (for names and avatars). Optional in dev.
STEAM_API_KEY=

# Postgres connection string. Leave unset in dev to use the embedded PGlite database in .data/.
# DATABASE_URL=postgres://user:password@localhost:5432/statsforisaac
